// ═══════════════════════════════════════════════
// اسکیمای پایگاه داده Market Troppy (PostgreSQL)
// ═══════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── کاربران و دسترسی‌ها (RBAC) ───
enum Role {
  USER
  EDITOR
  ADMIN
}

model User {
  id           String    @id @default(cuid())
  name         String?
  email        String    @unique
  emailVerified DateTime?
  image        String?
  passwordHash String? // هش bcrypt — هرگز پسورد plain ذخیره نمی‌شود
  role         Role      @default(USER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  posts    Post[]
  comments Comment[]
  auditLogs AuditLog[]

  @@map("users")
}

// ─── جداول NextAuth (Adapter) ───
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── بلاگ ───
enum PostStatus {
  DRAFT
  PUBLISHED
}

model Category {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  posts Post[]

  @@map("categories")
}

model Tag {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  posts Post[]

  @@map("tags")
}

model Post {
  id             String     @id @default(cuid())
  title          String
  slug           String     @unique
  excerpt        String     @db.Text
  content        String     @db.Text // خروجی امن‌شده‌ی ادیتور (بدون اسکریپت)
  coverImage     String?
  status         PostStatus @default(DRAFT)
  // تنظیمات سئو
  seoTitle       String?
  seoDescription String?
  focusKeyword   String?
  readingTime    Int        @default(5) // دقیقه
  views          Int        @default(0)
  publishedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  author     User       @relation(fields: [authorId], references: [id])
  authorId   String
  category   Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId String?
  tags       Tag[]
  comments   Comment[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@map("posts")
}

model Comment {
  id          String   @id @default(cuid())
  content     String   @db.Text
  authorName  String
  authorEmail String
  approved    Boolean  @default(false) // پیش‌فرض: نیازمند تایید ادمین
  createdAt   DateTime @default(now())
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId      String
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId      String?

  @@index([approved])
  @@map("comments")
}

// ─── خدمات ───
model Service {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  summary     String  @db.Text
  description String  @db.Text
  icon        String  @default("Sparkles") // نام آیکون Lucide
  order       Int     @default(0)
  features    Json?   // آرایه رشته‌ای امکانات
  isActive    Boolean @default(true)

  @@map("services")
}

// ─── نمونه‌کارها ───
model CaseStudy {
  id         String  @id @default(cuid())
  title      String
  slug       String  @unique
  client     String
  industry   String
  summary    String  @db.Text
  results    Json?   // [{ label: "رشد فروش", value: "+65%" }]
  coverImage String?
  published  Boolean @default(true)
  createdAt  DateTime @default(now())

  @@map("case_studies")
}

// ─── درخواست‌های بازاریابی ───
enum RequestStatus {
  NEW
  IN_PROGRESS
  DONE
}

model ConsultationRequest {
  id        String        @id @default(cuid())
  name      String
  phone     String
  field     String // حوزه فعالیت
  budget    String?
  message   String        @db.Text
  status    RequestStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
  @@map("consultation_requests")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Booking {
  id        String        @id @default(cuid())
  name      String
  phone     String
  email     String?
  date      DateTime
  timeSlot  String // مثلا "10:00-10:30"
  status    BookingStatus @default(PENDING)
  notes     String?
  createdAt DateTime      @default(now())

  @@index([date, status])
  @@map("bookings")
}

// ─── خبرنامه ───
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

// ─── لاگ فعالیت ادمین (Audit Trail) ───
model AuditLog {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  action    String // create | update | delete | status_change
  entity    String // post | user | comment | ...
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entity, createdAt])
  @@map("audit_logs")
}

// ─── تنظیمات سایت ───
model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value Json

  @@map("site_settings")
}
