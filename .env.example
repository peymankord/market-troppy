# ══════════════════════════════════════════════
# نمونه متغیرهای محیطی — این فایل را به .env کپی کنید
# هرگز مقادیر واقعی را در گیت کامیت نکنید!
# ══════════════════════════════════════════════

# پایگاه داده PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/market_troppy?schema=public"

# احراز هویت NextAuth v5
# تولید Secret: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32"
AUTH_URL="http://localhost:3000"

# Google OAuth (اختیاری) — از Google Cloud Console
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ارسال ایمیل با Resend (اختیاری — در نبود آن، ایمیل‌ها فقط لاگ می‌شوند)
RESEND_API_KEY=""
MAIL_FROM="Market Troppy <noreply@markettroppy.ir>"
MAIL_TO_ADMIN="info@markettroppy.ir"

# آدرس عمومی سایت برای سئو (canonical / sitemap / OG)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Rate Limiting با Upstash Redis (اختیاری — بدون آن از حافظه داخلی استفاده می‌شود)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# حساب ادمین اولیه برای seed
SEED_ADMIN_EMAIL="admin@markettroppy.ir"
SEED_ADMIN_PASSWORD="ChangeMe!123"
